    "@types/source-map-support": "^0.5.10",
    "@types/styled-components": "^5.1.34",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "debug": "^4.4.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
