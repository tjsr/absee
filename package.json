{
  "name": "absee",
  "version": "0.0.1",
  "description": "A comparison and data store tool",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "copyswipe": "shx cp -r ../abswipe/src/components/* ./src/ui/components/",
    "clean": "rimraf dist build node_modules",
    "start:server": "tsx watch server.ts",
    "start:ui": "vite dev",
    "start": "echo Run \"npm run start:ui\" then \"npm run start:server\"",
    "start:server2": "node -r source-map-support/register --experimental-specifier-resolution=node dist/server.js",
    "start:prod": "node index.js",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vite build && tsc",
    "build:client": "vite build",
    "cf:check:dev": "npm run build:client && wrangler deploy --dry-run --env dev",
    "cf:typegen:dev": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types worker-configuration.d.ts --env dev",
    "dev:worker": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --local --env dev",
    "deploy:dev": "npm run build:client && wrangler deploy --env dev",
    "test": "vitest --run && npm run lint",
    "db:init:dev": "wrangler d1 migrations apply pinpare --local --env dev",
    "db:upgrade": "wrangler d1 migrations apply pinpare --local --env dev",
    "db:upgrade:deploy": "wrangler d1 migrations apply pinpare --remote --env dev",
    "docker:stop": "docker stop restsqlite",
    "docker:sqlite": "docker run -v h/dev/absee/prisma:/db --name sqlite3 --rm -it keinos/sqlite3 sqlite3 /db/dev.db",
    "docker:restsqlite": "docker run -v h/dev/absee/prisma:/database --env DATABASE=dev.db --name restsqlite -p 8085:8085 --rm -d -t tjsrowe/restsqlite",
    "dev:upgrade": "npm run docker:stop && npm run db:upgrade && npm run docker:restsqlite",
    "format": "npm run prettier && npm run lint",
    "lint": "eslint --fix \"./src/**/*.{ts,tsx}\"",
    "postinstall": "npm run prisma:generate",
    "prettier": "prettier --single-quote --write \"./src/**/*.{ts,tsx}\"",
    "db:up": "wrangler d1 migrations apply pinpare --local --env dev",
    "db:up:clean": "wrangler d1 migrations apply pinpare --local --env dev",
    "db:down": "docker compose down",
    "prisma:generate": "npx prisma generate --config prisma.config.ts"
  },
  "test": "jest --runInBand --detectOpenHandles",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/tjsrowe/absee.git"
  },
  "author": "Tim Rowe <tim@tjsr.id.au>",
  "license": "ISC",
  "bugs": {
    "url": "https://bitbucket.org/tjsrowe/absee/issues"
  },
  "homepage": "./",
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@tjsr/eslint-config": "github:tjsr/eslint-config#main",
    "@tjsr/testutils": "^0.0.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "4.17.21",
    "@types/express-mysql-session": "3.0.6",
    "@types/express-session": "1.18.1",
    "@types/is-uuid": "^1.0.2",
    "@types/js-cookie": "^3.0.6",
    "@types/morgan": "^1.9.9",
    "@types/mysql": "^2.15.26",
    "@types/node": "^20.17.10",
    "@types/on-finished": "^2.3.4",
    "@types/passport": "^1.0.17",
